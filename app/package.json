    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:regression": "vitest run test/frontend/Files/drag.test.ts test/desktop/oauth2Window.test.ts test/desktop/HTTPServer.test.ts test/logic/Auth/OAuth2Window.test.ts test/logic/Auth/OAuth2Localhost.test.ts test/logic/Files/WebDAV/WebDAV.test.ts test/logic/Mail/OWA/networkRecovery.test.ts test/logic/Mail/OWA/deletionSync.test.ts test/logic/Mail/OWA/openFolderSync.test.ts test/logic/Mail/OWA/sharedMailboxFastSync.test.ts",
    "l10n:extract": "npx tsx l10n/extractor/extractor.ts",
    "l10n:placeholder": "npx json-autotranslate --input l10n/locales --service dry-run --delete-unused-strings --type key-based --exclude **/*.template.json",
    "l10n:auto-translate": "npx json-autotranslate --input l10n/locales --service deepl-free --config $DEEPL_API_KEY,default,1000 --delete-unused-strings --type key-based --template messages.template.json",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
