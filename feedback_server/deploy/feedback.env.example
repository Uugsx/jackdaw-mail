# /etc/jackdaw-feedback/feedback.env — права 0600, владелец root.
JACKDAW_FEEDBACK_HOST=127.0.0.1
JACKDAW_FEEDBACK_PORT=8092

# Письмо владельцу (Resend: smtp.resend.com:2587, пользователь resend, пароль — API-ключ).
JACKDAW_FEEDBACK_SMTP_HOST=smtp.resend.com
JACKDAW_FEEDBACK_SMTP_PORT=2587
JACKDAW_FEEDBACK_SMTP_USER=resend
JACKDAW_FEEDBACK_SMTP_PASSWORD_FILE=/etc/jackdaw-feedback/smtp.secret
JACKDAW_FEEDBACK_MAIL_FROM=Jackdaw Mail <noreply@jackdaw-mail.pro>
JACKDAW_FEEDBACK_MAIL_TO=

# Telegram: токен бота от @BotFather (файлом) и id закрытой группы (-100...).
# Необязательно: id темы, если в группе включены «Темы».
JACKDAW_FEEDBACK_TELEGRAM_TOKEN_FILE=/etc/jackdaw-feedback/telegram.secret
JACKDAW_FEEDBACK_TELEGRAM_CHAT_ID=
JACKDAW_FEEDBACK_TELEGRAM_THREAD_ID=

# GitHub: fine-grained токен только на один репозиторий, права Issues: Read and write.
# Issue создаётся только для типа «Ошибка», без адреса для ответа.
JACKDAW_FEEDBACK_GITHUB_TOKEN_FILE=/etc/jackdaw-feedback/github.secret
JACKDAW_FEEDBACK_GITHUB_REPO=
JACKDAW_FEEDBACK_GITHUB_LABELS=bug,feedback

# Лимиты в сутки: всего отзывов, issue в GitHub и писем (квота Resend общая с кодами звонков).
JACKDAW_FEEDBACK_DAILY_LIMIT=50
JACKDAW_FEEDBACK_GITHUB_DAILY_LIMIT=20
JACKDAW_FEEDBACK_EMAIL_DAILY_LIMIT=20
