[Unit]
Description=Jackdaw Mail calls and chat signaling (presence, ringing, WebRTC SDP/ICE relay, E2E chat queue)
After=network-online.target jackdaw-license.service
Wants=network-online.target

[Service]
Type=simple
# Тот же пользователь, что у сервиса лицензий: база лицензий читается напрямую.
# Запись в неё запрещена на уровне соединения (PRAGMA query_only).
User=jackdaw-license
Group=jackdaw-license
WorkingDirectory=/opt/jackdaw-calls
EnvironmentFile=/etc/jackdaw-calls/calls.env
ExecStart=/opt/jackdaw-calls/venv/bin/python /opt/jackdaw-calls/calls.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# WAL-режим SQLite требует записи в файл -shm даже для чтения.
ReadWritePaths=/var/lib/jackdaw-license /var/lib/jackdaw-calls
# Сервис работает от пользователя лицензий, но ключ подписи лицензий ему не нужен:
# при взломе сервиса звонков (WebSocket, SMTP :25) ключ не утечёт.
InaccessiblePaths=/etc/jackdaw-license
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077
# Только право слушать порт 25 для приёма писем обратного подтверждения (inbound.py)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
TasksMax=256
# Предел памяти: перегруженный сервис звонков не должен остановить лицензии и сайт на том же VPS
MemoryMax=512M

[Install]
WantedBy=multi-user.target
