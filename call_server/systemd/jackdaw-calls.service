[Unit]
Description=Jackdaw Mail calls and chat signaling (presence, ringing, WebRTC SDP/ICE relay, E2E chat queue)
After=network-online.target jackdaw-license.service
Wants=network-online.target

[Service]
Type=simple
# Тот же пользователь, что у сервиса лицензий: база лицензий читается напрямую.
# Запись в неё запрещена на уровне соединения (PRAGMA query_only).
User=jackdaw-license
Group=jackdaw-license
WorkingDirectory=/opt/jackdaw-calls
EnvironmentFile=/etc/jackdaw-calls/calls.env
ExecStart=/opt/jackdaw-calls/venv/bin/python /opt/jackdaw-calls/calls.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# WAL-режим SQLite требует записи в файл -shm даже для чтения.
ReadWritePaths=/var/lib/jackdaw-license /var/lib/jackdaw-calls
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077
CapabilityBoundingSet=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
TasksMax=256

[Install]
WantedBy=multi-user.target
