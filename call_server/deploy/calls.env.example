# /etc/jackdaw-calls/calls.env — права 0600, владелец root.
JACKDAW_CALLS_HOST=127.0.0.1
JACKDAW_CALLS_PORT=8091
JACKDAW_LICENSE_DB=/var/lib/jackdaw-license/license.sqlite3
# База чата и зашифрованные файлы
JACKDAW_CALLS_DATA_DIR=/var/lib/jackdaw-calls

# Секрет подписи подтверждений email (>= 32 байт): openssl rand -hex 32 > /etc/jackdaw-calls/proof.secret
JACKDAW_CALLS_PROOF_SECRET_FILE=/etc/jackdaw-calls/proof.secret

# Звонки — только голос, напрямую между клиентами (P2P WebRTC). Сервер медиа не нужен.
# Необязательно: свои STUN-серверы через запятую (только stun:/stuns:). Пусто — клиенты используют
# бесплатные публичные STUN Google и Cloudflare.
JACKDAW_CALLS_STUN_URLS=

# Необязательно: свой TURN (coturn, deploy/turnserver.conf.example) для собеседников за симметричным NAT
# или корпоративным фаерволом. Участникам принятого звонка выдаются временные учётные данные (HMAC).
# Задавать либо обе переменные, либо ни одной. Секрет (>= 32 символов) — тот же, что static-auth-secret coturn.
#JACKDAW_CALLS_TURN_URLS=turn:license.jackdaw-mail.pro:3478?transport=udp,turn:license.jackdaw-mail.pro:3478?transport=tcp
#JACKDAW_CALLS_TURN_SECRET_FILE=/etc/jackdaw-calls/turn.secret

# Необязательно и платно: LiveKit SFU (deploy/livekit.yaml). Без этих трёх переменных сервис работает в P2P.
# Задавать либо все три, либо ни одной — частичная настройка останавливает запуск.
#JACKDAW_LIVEKIT_URL=wss://calls.jackdaw-mail.pro
#JACKDAW_LIVEKIT_API_KEY=
#JACKDAW_LIVEKIT_API_SECRET_FILE=/etc/jackdaw-calls/livekit.secret

# SMTP для писем с кодом подтверждения (STARTTLS). Без них подтверждение адресов недоступно.
JACKDAW_CALLS_SMTP_HOST=
JACKDAW_CALLS_SMTP_PORT=587
JACKDAW_CALLS_SMTP_USER=
JACKDAW_CALLS_SMTP_PASSWORD_FILE=/etc/jackdaw-calls/smtp.secret
JACKDAW_CALLS_MAIL_FROM=Jackdaw Mail <noreply@jackdaw-mail.pro>

# Обратное подтверждение: пользователь отправляет письмо со своего ящика на
# verify+<токен>@<домен>. Нужны DNS-записи A и MX для домена на этот сервер
# и открытый входящий порт 25. Пусто — выключено.
JACKDAW_CALLS_INBOUND_DOMAIN=
JACKDAW_CALLS_INBOUND_PORT=25
JACKDAW_CALLS_INBOUND_HOST=0.0.0.0
