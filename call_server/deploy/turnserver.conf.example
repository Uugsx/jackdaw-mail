# /etc/turnserver.conf — coturn для звонков Jackdaw Mail. Права 0640, владелец root:turnserver.
# Ретранслирует голос, только когда собеседники не могут соединиться напрямую (симметричный NAT,
# корпоративный фаервол). Пускает только по временным учётным данным, которые сервис звонков
# выдаёт участникам принятого звонка (REST API coturn, `use-auth-secret`).

listening-port=3478
# Внешний адрес VPS: его клиенты получают в relay-кандидатах.
external-ip=82.22.187.238
realm=jackdaw-mail.pro

# Тот же секрет, что в /etc/jackdaw-calls/turn.secret (JACKDAW_CALLS_TURN_SECRET_FILE):
# openssl rand -hex 32
use-auth-secret
static-auth-secret=ЗАМЕНИТЬ_НА_СЕКРЕТ
fingerprint

# Порты ретрансляции: каждый участник звонка через TURN занимает один. Открыть в фаерволе (UDP).
min-port=49160
max-port=49359

# Нагрузка: голос Opus — десятки килобит в секунду; лимиты не дают превратить сервер в общий прокси.
max-bps=64000
# На участника: по выделению на UDP и TCP плюс новые при каждом перезапуске ICE (до ~4 за время переподключения).
user-quota=12
total-quota=200
stale-nonce=600

# Ретрансляция только в интернет: к loopback, частным сетям и метаданным облака — нельзя (SSRF).
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=240.0.0.0-255.255.255.255
denied-peer-ip=::1
# IPv4 внутри IPv6 (::ffff:127.0.0.1 и т. п.) и NAT64 — обход списков выше
denied-peer-ip=::ffff:0.0.0.0-::ffff:255.255.255.255
denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# Без TLS на этом этапе: голос и так зашифрован DTLS-SRTP между клиентами, TURN его не видит.
no-tls
no-dtls
no-cli
syslog
simple-log
# Голос идёт только по UDP; TCP-ретрансляция (RFC 6062) браузерам не нужна и открывала бы TCP-соединения к чужим хостам
no-tcp-relay
